// Меню профиля (в стиле Яндекс ID), страница настроек и экран входа по коду.

import { Theme } from "theme.slint";
import { Icons, Icon, Cover, NavCircle, PillButton, MusicMark } from "widgets.slint";
import { T, App } from "state.slint";

// Меню профиля — окно Яндекс ID оригинала (iframe yandex.ru/user-id): 320 в ширину,
// пункты 44, подменю языка и темы всплывают поверх. Иконки сняты с самого окна.
component IdRow inherits Rectangle {
    in property <image> icon;
    in property <string> text;
    in property <bool> active;
    in property <color> ink;
    callback clicked;
    height: 44px;
    border-radius: 12px;
    background: ta.has-hover || active ? #b4b8cc42 : transparent;
    animate background { duration: App.motion ? 150ms : 0ms; }
    Image { x: 16px; width: 24px; height: 24px; source: icon; colorize: ink; }
    Text {
        x: 56px;
        text: root.text;
        vertical-alignment: center;
        font-size: 16px;
        font-weight: 400;
        color: ink;
    }
    ta := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.clicked(); }
    }
}

component PickRow inherits Rectangle {
    in property <image> icon;
    in property <string> code;
    in property <string> text;
    in property <bool> selected;
    in property <color> ink;
    callback clicked;
    height: 48px;
    border-radius: 16px;
    background: selected || ta.has-hover ? #b4b8cc33 : transparent;
    animate background { duration: App.motion ? 150ms : 0ms; }
    if code == "": Image { x: 20px; width: 24px; height: 24px; source: icon; colorize: ink; }
    if code != "": Text {
        x: 20px;
        text: code;
        vertical-alignment: center;
        font-size: 16px;
        color: #8f8fa3;
    }
    Text {
        x: code == "" ? 56px : 50px;
        text: root.text;
        vertical-alignment: center;
        font-size: 16px;
        font-weight: 400;
        color: ink;
    }
    if selected: Image { x: parent.width - 44px; width: 24px; height: 24px; source: Icons.id-check; colorize: ink; }
    ta := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.clicked(); }
    }
}

component Toggle inherits Rectangle {
    in property <bool> on;
    width: 32px;
    height: 20px;
    border-radius: 10px;
    background: on ? #ffee00 : Theme.dark ? #ffffff1f : #00000012;
    Rectangle {
        x: on ? 14px : 2px;
        y: 2px;
        width: 16px;
        height: 16px;
        border-radius: 8px;
        background: on ? #000000 : Theme.dark ? #ffffff66 : #ffffffa3;
        animate x { duration: App.motion ? 150ms : 0ms; }
    }
}

export component AccountMenu inherits Rectangle {
    property <color> ink: Theme.dark ? #ffffff : #262633;
    property <brush> bg: Theme.dark ? #1f1f22 : #ffffff;
    property <string> lang-name: App.lang == "en" ? "English" : App.lang == "uz" ? "O‘zbek" : App.lang == "kk" ? "Қазақша" : "Русский";

    function act(id: string) {
        App.account-sub = -1;
        App.account-action(id);
    }

    TouchArea {
        clicked => {
            App.account-open = false;
            App.account-sub = -1;
        }
        scroll-event(e) => { accept }
    }

    box := Rectangle {
        x: 28px;
        y: root.height - 90px - self.height;
        width: 320px;
        height: 443px;
        border-radius: 24px;
        background: bg;
        drop-shadow-blur: 24px;
        drop-shadow-offset-y: 4px;
        drop-shadow-color: #00000033;
        TouchArea {
            clicked => { App.account-sub = -1; }
        }

        Image { x: 24px; y: 24px; width: 41px; height: 20px; source: Theme.dark ? Icons.id-logo-dark : Icons.id-logo; }
        Rectangle {
            x: 264px;
            y: 24px;
            width: 24px;
            height: 24px;
            Image { width: 24px; height: 24px; source: Icons.id-close; colorize: ink; }
            TouchArea {
                mouse-cursor: MouseCursor.pointer;
                clicked => {
                    App.account-open = false;
                    App.account-sub = -1;
                }
            }
        }

        // Вместо «Войдите в аккаунт» — сам аккаунт.
        Cover { x: 24px; y: 72px; width: 48px; height: 48px; round: true; source: App.avatar; }
        Text {
            x: 84px;
            y: 72px;
            width: 204px;
            height: App.plus ? 28px : 48px;
            text: App.login;
            overflow: elide;
            vertical-alignment: center;
            font-size: 20px;
            font-weight: 500;
            color: ink;
        }
        if App.plus: Text {
            x: 84px;
            y: 100px;
            text: T.t("Яндекс Плюс");
            font-size: 14px;
            color: #8f8fa3;
        }

        IdRow { x: 8px; y: 144px; width: 296px; ink: ink; icon: Icons.id-account; text: T.t("Управление аккаунтом"); clicked => { root.act("account"); } }
        IdRow { x: 8px; y: 188px; width: 296px; ink: ink; icon: Icons.id-settings; text: T.t("Настройки"); clicked => { root.act("settings"); } }
        IdRow { x: 8px; y: 232px; width: 296px; ink: ink; icon: Icons.id-support; text: T.t("Чат с поддержкой"); clicked => { root.act("support"); } }
        IdRow {
            x: 8px;
            y: 276px;
            width: 296px;
            ink: ink;
            icon: Icons.id-language;
            text: lang-name;
            active: App.account-sub == 0;
            clicked => { App.account-sub = App.account-sub == 0 ? -1 : 0; }
        }
        Rectangle { x: 24px; y: 329px; width: 264px; height: 1px; background: #b4b8cc47; }
        IdRow {
            x: 8px;
            y: 339px;
            width: 296px;
            ink: ink;
            icon: Icons.id-appearance;
            text: T.t("Внешний вид");
            active: App.account-sub == 1;
            clicked => { App.account-sub = App.account-sub == 1 ? -1 : 1; }
        }
        // Своё, в Яндекс ID такого нет: просили держать под рукой, а не в настройках.
        IdRow {
            x: 8px;
            y: 383px;
            width: 296px;
            ink: ink;
            icon: Icons.explicit;
            text: T.t("Треки 18+");
            clicked => { root.act("explicit"); }
            Toggle { x: parent.width - 16px - self.width; on: App.allow-explicit; }
        }

        if App.account-sub == 0: Rectangle {
            x: 12px;
            y: 276px - 10px - self.height;
            width: 296px;
            height: (App.translations ? 4 : 1) * 48px;
            border-radius: 20px;
            background: bg;
            drop-shadow-blur: 16px;
            drop-shadow-offset-y: 2px;
            drop-shadow-color: #00000033;
            TouchArea { }
            PickRow { y: 0; width: parent.width; ink: ink; code: "ru"; text: "Русский"; selected: App.lang == "ru"; clicked => { root.act("lang:ru"); } }
            PickRow { y: 48px; visible: App.translations; width: parent.width; ink: ink; code: "en"; text: "English"; selected: App.lang == "en"; clicked => { root.act("lang:en"); } }
            PickRow { y: 96px; visible: App.translations; width: parent.width; ink: ink; code: "uz"; text: "O‘zbek"; selected: App.lang == "uz"; clicked => { root.act("lang:uz"); } }
            PickRow { y: 144px; visible: App.translations; width: parent.width; ink: ink; code: "kk"; text: "Қазақша"; selected: App.lang == "kk"; clicked => { root.act("lang:kk"); } }
        }
        if App.account-sub == 1: Rectangle {
            x: 12px;
            y: 339px - 4px - self.height;
            width: 296px;
            height: 3 * 48px;
            border-radius: 20px;
            background: bg;
            drop-shadow-blur: 16px;
            drop-shadow-offset-y: 2px;
            drop-shadow-color: #00000033;
            TouchArea { }
            PickRow { y: 0; width: parent.width; ink: ink; icon: Icons.id-appearance; text: T.t("Всегда светлый"); selected: App.theme-mode == "light"; clicked => { root.act("theme:light"); } }
            PickRow { y: 48px; width: parent.width; ink: ink; icon: Icons.id-dark; text: T.t("Всегда тёмный"); selected: App.theme-mode == "dark"; clicked => { root.act("theme:dark"); } }
            PickRow { y: 96px; width: parent.width; ink: ink; icon: Icons.id-system; text: T.t("Как в системе"); selected: App.theme-mode != "light" && App.theme-mode != "dark"; clicked => { root.act("theme:system"); } }
        }
    }
}

// Пункт настроек: заголовок 16/700, подпись 12/500, справа переключатель или стрелка.
component SettingItem inherits Rectangle {
    in property <string> title;
    in property <string> desc;
    in property <bool> toggle;
    in property <bool> on;
    callback clicked;
    height: toggle ? (desc != "" ? 42px : 24px) : (desc != "" ? 54px : 32px);
    property <length> ty: toggle ? 0px : 4px;
    Text {
        x: 0;
        y: ty;
        width: parent.width - 60px;
        height: 24px;
        text: title;
        vertical-alignment: center;
        font-size: 16px;
        font-weight: 700;
        color: Theme.controls-color-primary-text-enabled-variant;
    }
    if desc != "": Text {
        x: 0;
        y: ty + (toggle ? 24px : 28px);
        width: parent.width - 40px;
        height: 18px;
        text: desc;
        overflow: elide;
        font-size: 12px;
        font-weight: 500;
        color: Theme.controls-color-primary-text-enabled;
    }
    if toggle: Toggle { x: parent.width - 32px; on: on; }
    if !toggle: Icon { x: parent.width - 24px; source: Icons.arrow-right; size: 24px; colorize: Theme.controls-color-primary-text-enabled; }
    if root.toggle: TouchArea {
        accessible-role: switch;
        accessible-label: root.title;
        accessible-description: root.desc;
        accessible-checked: root.on;
        accessible-action-default => { root.clicked(); }
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    if !root.toggle: TouchArea {
        accessible-role: button;
        accessible-label: root.title;
        accessible-description: root.desc;
        accessible-action-default => { root.clicked(); }
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.clicked(); }
    }
}

// Вариант режима работы: кружок выбора, название и подпись.
component ModeOption inherits Rectangle {
    in property <string> title;
    in property <string> desc;
    in property <bool> selected;
    callback clicked;
    height: 42px;
    Rectangle {
        x: 0;
        y: 2px;
        width: 20px;
        height: 20px;
        border-radius: 10px;
        background: selected ? Theme.controls-color-primary-default-enabled : transparent;
        border-width: selected ? 0 : 2px;
        border-color: Theme.controls-color-primary-text-enabled;
        if selected: Rectangle { width: 8px; height: 8px; border-radius: 4px; background: #000000; }
    }
    Text {
        x: 32px;
        y: 0;
        width: parent.width - 32px;
        height: 24px;
        text: title;
        vertical-alignment: center;
        font-size: 16px;
        font-weight: 700;
        color: Theme.controls-color-primary-text-enabled-variant;
    }
    Text {
        x: 32px;
        y: 24px;
        width: parent.width - 32px;
        height: 18px;
        text: desc;
        overflow: elide;
        font-size: 12px;
        font-weight: 500;
        color: Theme.controls-color-primary-text-enabled;
    }
    TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.clicked(); }
    }
}

export component SettingsPage inherits Rectangle {
    Flickable {
        content-height: list.y + list.preferred-height + 40px;
        if App.can-back: NavCircle {
            x: 24px;
            y: 24px;
            icon: Icons.arrow-left-small;
            clicked => { App.go-back(); }
        }
        Text {
            x: App.can-back ? 72px : 24px;
            y: 24px;
            height: 32px;
            text: T.t("Настройки");
            vertical-alignment: center;
            font-family: "YS Music Headline";
            font-size: Theme.font-size-headline-xl;
            font-weight: 700;
            color: Theme.controls-color-primary-text-enabled-variant;
        }
        list := VerticalLayout {
            x: 24px;
            y: 116px;
            width: 482px;
            spacing: 36px;
            alignment: start;
            SettingItem { title: T.t("Очистить память"); clicked => { App.setting("clear"); } }
            SettingItem {
                title: T.t("Эквалайзер");
                desc: App.eq-on ? T.t("Включен") : T.t("Выключен");
                clicked => { App.eq-open = true; }
            }
            VerticalLayout {
                spacing: 16px;
                Text {
                    height: 24px;
                    text: T.t("Режим работы");
                    vertical-alignment: center;
                    font-size: 16px;
                    font-weight: 700;
                    color: Theme.controls-color-primary-text-enabled-variant;
                }
                ModeOption {
                    title: T.t("Плавный");
                    desc: T.t("Все анимации интерфейса");
                    selected: App.motion;
                    clicked => { App.setting("mode:smooth"); }
                }
                ModeOption {
                    title: T.t("Лёгкий");
                    desc: T.t("Без анимаций, меньше памяти");
                    selected: !App.motion;
                    clicked => { App.setting("mode:lite"); }
                }
            }
            SettingItem {
                title: T.t("Папка для скачивания");
                desc: App.download-dir;
                clicked => { App.setting("download-dir"); }
            }
            SettingItem {
                title: T.t("Скачивать в FLAC");
                desc: T.t("Без потерь, если у трека есть такая версия. Если нет, скачается MP3");
                toggle: true;
                on: App.download-flac;
                clicked => { App.setting("download-flac"); }
            }
            VerticalLayout {
                spacing: 16px;
                Text {
                    text: T.t("Воспроизведение");
                    font-family: Theme.display-font;
                    font-size: Theme.font-size-headline-xs;
                    font-weight: 700;
                    color: Theme.controls-color-primary-text-enabled-variant;
                }
                SettingItem {
                    title: T.t("Без повторов в Моей волне");
                    desc: T.t("Один и тот же трек может вернуться через 24 часа");
                    toggle: true;
                    on: App.unique-wave;
                    clicked => { App.setting("unique-wave"); }
                }
                SettingItem {
                    title: T.t("Пропускать изменённую скорость");
                    desc: T.t("Ускоренные и замедленные версии в рекомендациях");
                    toggle: true;
                    on: App.skip-speed;
                    clicked => { App.setting("skip-speed"); }
                }
                SettingItem {
                    title: T.t("Пропускать ремиксы");
                    desc: T.t("В рекомендациях");
                    toggle: true;
                    on: App.skip-remix;
                    clicked => { App.setting("skip-remix"); }
                }
                SettingItem {
                    title: T.t("Пропускать концертные версии");
                    desc: T.t("В рекомендациях");
                    toggle: true;
                    on: App.skip-live;
                    clicked => { App.setting("skip-live"); }
                }
                SettingItem {
                    title: T.t("Останавливать в конце списка");
                    desc: T.t("После последнего трека альбома или плейлиста");
                    toggle: true;
                    on: App.stop-at-end;
                    clicked => { App.setting("stop-at-end"); }
                }
                SettingItem {
                    title: T.t("Блокировать и совместные треки");
                    desc: T.t("Если заблокированный артист указан в числе исполнителей");
                    toggle: true;
                    on: App.block-features;
                    clicked => { App.setting("block-features"); }
                }
                SettingItem {
                    title: T.t("Плавный переход");
                    desc: T.t("Сведение в бит. Часть тихого вступления может быть пропущена");
                    toggle: true;
                    on: App.crossfade;
                    clicked => { App.setting("crossfade"); }
                }
                if App.crossfade: HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    for seconds in [3, 6, 9, 12]: PillButton {
                        text: seconds + " с";
                        height: 32px;
                        primary: seconds == App.crossfade-seconds;
                        clicked => { App.set-crossfade-seconds(seconds); }
                    }
                }
                for artist in App.blocked-artists: SettingItem {
                    title: artist.text;
                    desc: T.t("Разблокировать исполнителя");
                    clicked => { App.setting("unblock:" + artist.id); }
                }
            }
            if App.hidden-blocks != "": SettingItem {
                title: T.t("Вернуть скрытые блоки");
                desc: App.hidden-blocks;
                clicked => { App.setting("hidden-blocks"); }
            }
            SettingItem {
                title: T.t("Меньше ИИ");
                desc: T.t("Реже включать треки, созданные с помощью ИИ");
                toggle: true;
                on: App.less-ai;
                clicked => { App.setting("less-ai"); }
            }
            SettingItem {
                title: T.t("Статус в Discord");
                desc: App.discord-on && App.discord-status != "" ? App.discord-status : T.t("Показывать текущий трек в профиле Discord");
                toggle: true;
                on: App.discord-on;
                clicked => { App.setting("discord"); }
            }
            SettingItem {
                title: App.windows ? T.t("Запускать вместе с Windows") : T.t("Запускать вместе с системой");
                desc: App.windows ? T.t("Приложение откроется в трее, без окна") : T.t("Приложение откроется при входе в систему");
                toggle: true;
                on: App.autostart;
                clicked => { App.setting("autostart"); }
            }
            if App.updates-available: SettingItem {
                title: T.t("Проверять обновления");
                desc: T.t("Раз в полчаса спрашивать GitHub, нет ли новой версии");
                toggle: true;
                on: App.check-updates;
                clicked => { App.setting("check-updates"); }
            }
            SettingItem {
                title: T.t("Выйти из аккаунта");
                desc: App.login;
                clicked => { App.setting("logout"); }
            }
            SettingItem {
                title: T.t("О приложении");
                desc: App.app-name + " · " + T.t("Версия ") + App.version;
                clicked => { App.setting("about"); }
            }
        }
    }
}

export component AboutDialog inherits Rectangle {
    background: Theme.background-color-primary-enabled-overlay;
    TouchArea { clicked => { App.about-open = false; } }
    Rectangle {
        width: 400px;
        height: contents.preferred-height;
        border-radius: Theme.radius-size-xl;
        background: Theme.background-color-primary-enabled-popover;
        TouchArea { }
        FocusScope {
            init => { self.focus(); }
            key-pressed(event) => {
                if event.text == Key.Escape {
                    App.about-open = false;
                    return accept;
                }
                return reject;
            }
        }
        contents := VerticalLayout {
            padding: 24px;
            spacing: 12px;
            alignment: start;
            HorizontalLayout {
                alignment: start;
                spacing: 12px;
                MusicMark { width: 40px; height: 40px; }
                Text {
                    text: App.app-name;
                    font-family: Theme.display-font;
                    font-size: Theme.font-size-headline-m;
                    font-weight: 700;
                    color: Theme.controls-color-primary-text-enabled-variant;
                    vertical-alignment: center;
                }
            }
            Text {
                text: T.t("Независимый клиент. Проект не связан с Яндексом.");
                font-size: Theme.font-size-label-m;
                color: Theme.controls-color-primary-text-enabled;
                wrap: word-wrap;
            }
            Text {
                text: T.t("Версия ") + App.version + " · GPL-3.0";
                font-size: Theme.font-size-label-s;
                color: Theme.controls-color-primary-text-enabled;
            }
            HorizontalLayout {
                alignment: start;
                spacing: 8px;
                if App.project-repository != "": PillButton {
                    text: "GitHub";
                    clicked => { App.setting("project-repository"); }
                }
                PillButton {
                    text: T.t("Поддержка") + " @dozhr";
                    clicked => { App.setting("project-support"); }
                }
                PillButton {
                    text: T.t("Закрыть");
                    clicked => { App.about-open = false; }
                }
            }
        }
    }
}

// Вход: код устройства для ya.ru/device. Окно поверх приложения, пока нет токена.
export component LoginScreen inherits Rectangle {
    background: Theme.background-color-primary-enabled-basic;
    property <brush> ink: Theme.controls-color-primary-text-enabled-variant;
    property <brush> secondary: Theme.controls-color-primary-text-enabled;
    property <bool> ready: !App.restoring-login && App.login-code != "";
    property <bool> failed: !App.restoring-login && App.login-error != "";
    TouchArea { }

    panel := Rectangle {
        width: min(448px, parent.width - 48px);
        height: content.preferred-height;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        background: Theme.background-color-primary-enabled-popover;
        border-radius: 26px;
        content := VerticalLayout {
            padding: 32px;
            spacing: 0;
            HorizontalLayout {
                height: 48px;
                alignment: start;
                spacing: 12px;
                MusicMark { width: 48px; height: 48px; }
                VerticalLayout {
                    alignment: center;
                    Text {
                        text: App.app-name;
                        font-family: Theme.display-font;
                        font-size: 20px; font-weight: 700;
                        color: root.ink;
                    }
                    Text {
                        text: T.t("Независимый клиент");
                        font-size: Theme.font-size-label-s;
                        color: root.secondary;
                    }
                }
            }
            Rectangle { height: 24px; }
            Rectangle { height: 1px; background: Theme.controls-color-secondary-outline-enabled-stroke; }
            Rectangle { height: 24px; }
            Text {
                text: App.restoring-login ? T.t("Проверяем вход") : T.t("Вход по коду");
                font-family: Theme.display-font;
                font-size: Theme.font-size-headline-xl;
                font-weight: 700;
                color: root.ink;
            }
            Rectangle { height: 8px; }
            Text {
                text: App.restoring-login ? T.t("Подключаем сохранённый аккаунт…")
                    : root.failed ? App.login-error
                    : root.ready ? T.t("Введите этот код на ya.ru/device с компьютера или телефона.")
                    : T.t("Получаем код у Яндекса…");
                wrap: word-wrap;
                font-size: Theme.font-size-label-m;
                color: root.secondary;
            }
            if root.ready: Rectangle { height: 20px; }
            if root.ready: Rectangle {
                height: 72px;
                border-radius: 12px;
                background: Theme.controls-color-secondary-default-enabled;
                Text {
                    text: App.login-code;
                    font-family: "Menlo"; font-weight: 700;
                    font-size: App.login-code.character-count > 10 ? 24px : 32px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    color: root.ink;
                }
            }
            if root.ready || root.failed: Rectangle { height: 20px; }
            if root.ready || root.failed: HorizontalLayout {
                alignment: start;
                spacing: 8px;
                if root.ready: PillButton {
                    primary: true; text: T.t("Открыть ya.ru/device");
                    clicked => { App.login-open(); }
                }
                if root.ready: PillButton {
                    text: T.t("Скопировать код"); clicked => { App.login-copy(); }
                }
                if root.failed: PillButton {
                    primary: true;
                    text: App.login-retry ? T.t("Повторить") : T.t("Получить новый код");
                    clicked => { App.login-start(); }
                }
            }
            if root.ready: Rectangle { height: 16px; }
            if root.ready: Text {
                text: T.t("После подтверждения музыка откроется здесь.");
                wrap: word-wrap;
                font-size: Theme.font-size-label-s;
                color: root.secondary;
            }
        }
    }
}
