// «Моя волна»: колесо вайбов, кнопка запуска и фоновое пятно в цветах трека.

import { Theme } from "theme.slint";
import { Icons, Icon, Cover, PillButton } from "widgets.slint";
import { T, App, WheelEntry } from "state.slint";
import { VolumePopup } from "popups.slint";
import { ScrollView } from "std-widgets.slint";

global WaveType {
    out property <string> heading: "YS Music Headline";
    out property <string> body: "YS Text";
}

component GlassButton inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <length> icon-size: 24px;
    in property <bool> enabled: true;
    out property <bool> hovered: ta.has-hover;
    callback clicked;
    accessible-role: button;
    accessible-label: label;
    accessible-enabled: enabled;
    accessible-action-default => { if enabled { root.clicked(); } }
    width: 48px;
    height: 48px;
    border-radius: self.height / 2;
    background: ta.has-hover && enabled ? #ffffff24 : #ffffff14;
    animate background { duration: App.motion ? Theme.duration-transition : 0ms; }
    Icon { source: icon; size: icon-size; colorize: enabled ? (ta.has-hover ? #ffffffe6 : #ffffffb3) : #ffffff14; }
    ta := TouchArea {
        enabled: enabled;
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.clicked(); }
    }
}

// Слот колеса. `p` — расстояние от центра в слайдах; сдвиг и прозрачность — формула оригинала.
component WheelSlot inherits Rectangle {
    in property <WheelEntry> entry;
    in property <float> p;
    in property <length> slide-h;
    in property <length> wrap-x;
    in property <length> area-h;
    in property <length> area-w;
    callback clicked;
    accessible-role: button;
    accessible-label: entry.description == "" ? entry.name : entry.description + " " + entry.name;
    accessible-action-default => { root.clicked(); }

    property <float> t: abs(p) / 4;
    property <float> f: t <= 1 ? 3.14159265 - t * 1.57079633 : t <= 2 ? 1.57079633 - (t - 1) * 1.57079633 : 0;
    property <float> a: min(t / 2, 1);
    property <float> s: max(0, min(1, (a - 0.42) / 0.58));
    property <length> yc: area-h / 2 + p * slide-h;
    // Маска оригинала: прозрачные 15% сверху и снизу.
    property <float> edge: yc < area-h * 0.15 ? yc / (area-h * 0.15) : yc > area-h * 0.85 ? (area-h - yc) / (area-h * 0.15) : 1;

    x: wrap-x + 120px * (1 + cos(f * 1rad));
    y: yc - 40px;
    width: 334px;
    height: 80px;
    // Прозрачность раздаётся детям: opacity на слоте — слой на каждый слот в каждом кадре.
    property <float> alpha: max(0, edge) * (1 - 0.86 * s * s * (3 - 2 * s));
    visible: alpha > 0.004;

    Cover {
        x: 0;
        width: 80px;
        height: 80px;
        round: entry.round;
        radius: 0;
        background: transparent;
        source: entry.cover;
        alpha: root.alpha;
        if ta.has-hover && entry.playable: Rectangle {
            width: 40px;
            height: 40px;
            Icon { source: Icons.play-filled; size: 40px; colorize: #ffffff.with-alpha(root.alpha); }
        }
    }
    VerticalLayout {
        x: 96px;
        // Как у оригинала: подпись тянется до края колеса, а не до фиксированных 202.
        width: max(40px, root.area-w - root.x - 96px - 5px);
        alignment: center;
        spacing: 4px;
        if entry.description != "": Text {
            text: entry.description;
            overflow: elide;
            font-family: WaveType.body;
            font-size: Theme.font-size-label-m;
            font-weight: 500;
            color: #ffffff.with-alpha(0.5 * root.alpha);
        }
        Text {
            text: entry.name;
            wrap: word-wrap;
            overflow: elide;
            max-height: 40px;
            font-family: WaveType.body;
            font-size: Theme.font-size-label-l;
            font-weight: 500;
            color: #ffffff.with-alpha(root.alpha);
        }
    }
    ta := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.clicked(); }
    }
}


// Заголовок волны: самый крупный размер от 104 до 48, при котором слова не рвутся
// и текст влезает по высоте (не больше 4 строк), — как useDynamicText оригинала.
component FitTitle inherits Rectangle {
    in property <string> text;
    in property <string> longest;
    in property <bool> link;
    in property <length> max-size: 104px;
    callback clicked;

    property <length> w: root.width;
    property <length> h: root.height;
    p104 := Text { visible: false; width: w; text: root.text; wrap: word-wrap; font-family: "YS Music Headline"; font-weight: 700; font-size: 104px; }
    p96 := Text { visible: false; width: w; text: root.text; wrap: word-wrap; font-family: "YS Music Headline"; font-weight: 700; font-size: 96px; }
    p88 := Text { visible: false; width: w; text: root.text; wrap: word-wrap; font-family: "YS Music Headline"; font-weight: 700; font-size: 88px; }
    p80 := Text { visible: false; width: w; text: root.text; wrap: word-wrap; font-family: "YS Music Headline"; font-weight: 700; font-size: 80px; }
    p72 := Text { visible: false; width: w; text: root.text; wrap: word-wrap; font-family: "YS Music Headline"; font-weight: 700; font-size: 72px; }
    p64 := Text { visible: false; width: w; text: root.text; wrap: word-wrap; font-family: "YS Music Headline"; font-weight: 700; font-size: 64px; }
    p56 := Text { visible: false; width: w; text: root.text; wrap: word-wrap; font-family: "YS Music Headline"; font-weight: 700; font-size: 56px; }
    w104 := Text { visible: false; text: root.longest; font-family: "YS Music Headline"; font-weight: 700; font-size: 104px; }
    w96 := Text { visible: false; text: root.longest; font-family: "YS Music Headline"; font-weight: 700; font-size: 96px; }
    w88 := Text { visible: false; text: root.longest; font-family: "YS Music Headline"; font-weight: 700; font-size: 88px; }
    w80 := Text { visible: false; text: root.longest; font-family: "YS Music Headline"; font-weight: 700; font-size: 80px; }
    w72 := Text { visible: false; text: root.longest; font-family: "YS Music Headline"; font-weight: 700; font-size: 72px; }
    w64 := Text { visible: false; text: root.longest; font-family: "YS Music Headline"; font-weight: 700; font-size: 64px; }
    w56 := Text { visible: false; text: root.longest; font-family: "YS Music Headline"; font-weight: 700; font-size: 56px; }

    property <length> size:
          max-size >= 104px && w104.preferred-width <= w && p104.preferred-height <= min(h, 4 * 104px * 1.25) ? 104px
        : max-size >= 96px && w96.preferred-width <= w && p96.preferred-height <= min(h, 4 * 96px * 1.25) ? 96px
        : max-size >= 88px && w88.preferred-width <= w && p88.preferred-height <= min(h, 4 * 88px * 1.25) ? 88px
        : max-size >= 80px && w80.preferred-width <= w && p80.preferred-height <= min(h, 4 * 80px * 1.25) ? 80px
        : max-size >= 72px && w72.preferred-width <= w && p72.preferred-height <= min(h, 4 * 72px * 1.25) ? 72px
        : w64.preferred-width <= w && p64.preferred-height <= min(h, 4 * 64px * 1.25) ? 64px
        : w56.preferred-width <= w && p56.preferred-height <= min(h, 4 * 56px * 1.25) ? 56px
        : 48px;

    shown := Text {
        width: w;
        height: h;
        text: root.text;
        wrap: word-wrap;
        overflow: elide;
        horizontal-alignment: center;
        vertical-alignment: center;
        font-family: "YS Music Headline";
        font-size: root.size;
        font-weight: 700;
        color: #ffffff;
    }
    line := Text { visible: false; text: root.text; font-family: "YS Music Headline"; font-weight: 700; font-size: root.size; }
    // Кликабельна только сама надпись, а не пустое место вокруг.
    if root.link: TouchArea {
        width: min(w, line.preferred-width);
        height: min(h, shown.preferred-height);
        x: (w - self.width) / 2;
        y: (h - self.height) / 2;
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.clicked(); }
    }
}

// «Челка» над пятном: источник волны и отдельная круглая кнопка сброса.
component ContextPill inherits Rectangle {
    in property <string> text;
    callback reset;
    height: 48px;
    property <length> btn: 48px;
    property <length> pill-w: min(label.preferred-width + 48px, root.width - btn - 4px);
    pill := Rectangle {
        x: (root.width - pill-w - 4px - btn) / 2;
        width: pill-w;
        border-radius: 24px;
        background: pill-ta.pressed ? #00000099 : pill-ta.has-hover ? #00000066 : #0000004d;
        animate background { duration: App.motion ? Theme.duration-transition : 0ms; }
        label := Text {
            x: 24px;
            width: parent.width - 48px;
            text: root.text;
            overflow: elide;
            horizontal-alignment: center;
            vertical-alignment: center;
            font-family: WaveType.heading;
            font-size: Theme.font-size-headline-xs;
            font-weight: 700;
            color: Theme.logo-color-primary-player;
        }
        pill-ta := TouchArea {
            mouse-cursor: MouseCursor.pointer;
            clicked => { root.reset(); }
        }
    }
    Rectangle {
        x: pill.x + pill.width + 4px;
        width: btn;
        border-radius: btn / 2;
        background: x-ta.pressed ? #00000099 : x-ta.has-hover ? #00000066 : #0000004d;
        animate background { duration: App.motion ? Theme.duration-transition : 0ms; }
        Icon { source: Icons.close-small; size: 24px; colorize: x-ta.has-hover ? #ffffffe6 : #ffffff80; }
        x-ta := TouchArea {
            mouse-cursor: MouseCursor.pointer;
            clicked => { root.reset(); }
        }
    }
}

component MacContextPill inherits Rectangle {
    in property <string> text;
    callback reset;
    height: 48px;
    Rectangle {
        width: min(parent.width, label.preferred-width + 64px);
        border-radius: 24px;
        background: @linear-gradient(90deg, App.vibe-stops[11].with-alpha(0.85), App.vibe-stops[3].with-alpha(0.75));
        label := Text {
            x: 20px;
            width: parent.width - 64px;
            text: root.text;
            overflow: elide;
            horizontal-alignment: center;
            vertical-alignment: center;
            font-family: WaveType.heading;
            font-size: Theme.font-size-headline-xs;
            font-weight: 700;
            color: Theme.logo-color-primary-player;
        }
        Rectangle {
            x: parent.width - 35px;
            width: 22px;
            height: 22px;
            border-radius: 11px;
            background: reset-ta.has-hover ? Theme.controls-color-primary-default-hovered : Theme.controls-color-primary-default-enabled;
            accessible-role: button;
            accessible-label: T.t("Закрыть");
            accessible-action-default => { root.reset(); }
            Icon { source: Icons.close-small; size: 16px; colorize: #000; }
            reset-ta := TouchArea {
                mouse-cursor: MouseCursor.pointer;
                clicked => { root.reset(); }
            }
        }
    }
}

component WaveFilters inherits Rectangle {
    background: Theme.background-color-primary-enabled-overlay;
    TouchArea { clicked => { App.wave-filters-open = false; } }
    panel := Rectangle {
        width: min(parent.width - 48px, 440px);
        height: min(parent.height - 48px, 560px);
        border-radius: Theme.radius-size-xl;
        background: Theme.background-color-primary-enabled-popover;
        TouchArea { }
        Text {
            x: 24px;
            y: 20px;
            width: parent.width - 48px;
            text: T.t("Настроить Мою волну");
            font-family: Theme.display-font;
            font-size: 24px;
            font-weight: 700;
            color: Theme.controls-color-primary-text-enabled-variant;
        }
        if App.wave-filters-loading || App.wave-filters-error != "": Text {
            x: 24px;
            y: 65px;
            width: parent.width - 48px;
            text: App.wave-filters-loading ? T.t("Загрузка…") : App.wave-filters-error;
            horizontal-alignment: center;
            color: Theme.controls-color-primary-text-enabled;
        }
        if App.wave-filter-groups.length > 0 && !App.wave-filters-loading: ScrollView {
            x: 24px;
            y: App.wave-filters-error == "" ? 72px : 106px;
            width: parent.width - 48px;
            height: parent.height - self.y - 76px;
            VerticalLayout {
                width: parent.width - 12px;
                padding-top: 4px;
                padding-bottom: 8px;
                spacing: 18px;
                for group[g] in App.wave-filter-groups: VerticalLayout {
                    spacing: 6px;
                    Text {
                        text: group.title;
                        font-size: Theme.font-size-label-m;
                        font-weight: 700;
                        color: Theme.controls-color-primary-text-enabled-variant;
                    }
                    for option[i] in group.options: PillButton {
                        text: option.label;
                        primary: option.selected;
                        clicked => { App.select-wave-filter(g, i); }
                    }
                }
            }
        }
        HorizontalLayout {
            x: 24px;
            y: parent.height - 56px;
            width: parent.width - 48px;
            height: 40px;
            alignment: end;
            spacing: 8px;
            PillButton {
                text: T.t("Закрыть");
                clicked => { App.wave-filters-open = false; }
            }
            if App.wave-filter-groups.length > 0 && !App.wave-filters-loading: PillButton {
                primary: true;
                text: T.t("Применить");
                clicked => { App.apply-wave-filters(); }
            }
        }
    }
}

export component WavePage inherits Rectangle {
    // Раскладка оригинала: колесо — левые 40%, справа мета с отступами 24 и 48.
    property <length> wheel-w: root.width * 0.4;
    property <length> text-x: wheel-w + 24px;
    property <length> text-w: root.width - text-x - 48px;
    property <length> cx: text-x + text-w / 2;
    property <length> blob: root.width * (App.macos ? 0.82 : 0.6 * 1.107);
    property <bool> paused: App.has-track && !App.playing;
    property <length> title-y: App.wave-context ? 84px : 98px;
    // Высота окна и сдвиги по замерам оригинала при 700–1100: плеер прижат к низу (H − 248),
    // заголовок и пятно — к середине; ниже 800 отступы меньше.
    property <length> wh: root.height + 20px;
    property <length> dp: App.macos ? root.height - 780px : max(wh - 248px, min(wh - 200px, 600px)) - 600px;
    property <length> dt: max(wh / 2 - 225px, min(wh / 2 - 209px, 191px)) - 191px;
    property <length> db: max(wh / 2 - 458px, min(wh / 2 - 442px, -42px)) + 42px;
    property <float> progress: App.duration > 0 ? App.position / App.duration : 0;
    property <float> drag-progress: -1;
    property <float> shown: drag-progress >= 0 ? drag-progress : progress;
    property <length> artwork-top: max(104px, 110px + dp * 0.12);
    property <length> artwork-height: max(0px, 508px + dp - artwork-top);
    property <length> album-side: clamp(text-w * 0.22, 72px, 96px);
    property <length> wave-action-size: App.macos ? clamp((text-w - 190px) / 4, 36px, 48px) : 48px;
    property <length> wave-track-width: min(346px, text-w - 4 * (wave-action-size + 4px));
    property <string> fact: App.wave-message.text;
    property <string> track-label: (App.macos && paused && App.artists != "" ? App.artists + " — " : "") + App.title
        + (App.macos && App.track-version != "" ? " (" + App.track-version + ")" : "");
    changed fact => { if App.wave-fact-open { App.close-wave-fact(); } }

    if App.macos && App.has-track && App.playing && App.wave-frame.width == 0: Rectangle {
        x: root.width * 0.14;
        y: -root.height * 0.14;
        width: root.width;
        height: root.height * 1.14;
        background: @radial-gradient(circle,
            App.vibe-stops[0].with-alpha(0.77) 0%,
            App.vibe-stops[1].with-alpha(0.45) 35%,
            App.vibe-stops[4].with-alpha(0.16) 63%, transparent 84%);
    }

    // Пятно: картинка оригинала, перекрашенная под трек.
    if App.wave-frame.width == 0: Image {
        x: cx - blob / 2;
        y: 284px + db - blob / 2;
        width: blob;
        height: blob;
        source: App.blob;
        image-fit: contain;
        opacity: 0.8;
    }
    if App.macos && App.wave-frame.width > 0: Image {
        width: text-w * 2.5;
        height: self.width;
        x: cx - self.width / 2;
        y: 284px + db - self.height / 2;
        source: App.wave-frame;
        image-fit: contain;
        opacity: 0.8;
    }
    if App.macos && App.has-track && !paused && App.wave-artwork-is-artist: Image {
        x: text-x + 8px;
        y: artwork-top;
        width: text-w - 16px;
        height: artwork-height;
        source: App.wave-artwork;
        image-fit: contain;
        accessible-role: image;
        accessible-label: App.artists;
    }
    if App.macos && App.has-track: Cover {
        x: cx - self.width / 2;
        y: 480px + dp - self.height;
        width: album-side;
        height: album-side;
        radius: Theme.radius-size-m;
        source: !App.wave-artwork-is-artist && App.wave-artwork.width > 0 ? App.wave-artwork : App.cover;
        accessible-role: button;
        accessible-label: App.title;
        accessible-action-default => { App.open-current-album(); }
        TouchArea {
            mouse-cursor: MouseCursor.pointer;
            clicked => { App.open-current-album(); }
        }
    }
    if App.macos && App.has-track && !paused && App.wave-artwork-is-artist && App.artists != "": Rectangle {
        x: text-x;
        y: 82px;
        width: text-w;
        height: 64px;
        accessible-role: button;
        accessible-label: App.artists;
        accessible-enabled: App.artist-list.length > 0;
        accessible-action-default => { if App.artist-list.length > 0 { App.open-current-artist(0); } }
        property <length> single-size: clamp(floor(64 * self.width / max(1px, measure.preferred-width)) * 1px - 1px, 24px, 63px);
        measure := Text {
            visible: false;
            text: App.artists;
            font-family: WaveType.heading;
            font-weight: 700;
            font-size: 64px;
        }
        Text {
            text: App.artists;
            font-family: WaveType.heading;
            font-weight: 700;
            font-size: max(parent.single-size, 32px);
            color: artist-ta.has-hover ? Theme.controls-color-primary-default-enabled : #ffffff;
            horizontal-alignment: center;
            vertical-alignment: center;
            overflow: elide;
            wrap: parent.single-size < 32px ? word-wrap : no-wrap;
            width: parent.width;
        }
        artist-ta := TouchArea {
            enabled: App.artist-list.length > 0;
            mouse-cursor: MouseCursor.pointer;
            clicked => { App.open-current-artist(0); }
        }
    }
    if App.macos && App.has-track && !paused && !App.wave-artwork-is-artist && App.artists != "": FitTitle {
        x: text-x;
        y: title-y;
        width: text-w;
        height: max(58px, 464px + dp - album-side - self.y);
        max-size: App.plus ? 104px : 72px;
        text: App.artists;
        longest: App.artists-longest;
        link: App.artist-list.length > 0;
        accessible-role: button;
        accessible-label: App.artists;
        accessible-enabled: self.link;
        accessible-action-default => { if self.link { App.open-current-artist(0); } }
        clicked => { App.open-current-artist(0); }
    }

    // Колесо вайбов: бесконечная лента, крутится колёсиком мыши.
    wheel := Rectangle {
        x: 0;
        y: 0;
        width: wheel-w;
        height: root.height;
        clip: true;

        property <int> n: App.wheel.length;
        property <int> per-view: max(4, min(9, floor(self.height / 106px)));
        property <length> slide-h: self.height / per-view;
        property <length> wrap-x: self.width - min(self.width * 0.8, 600px);
        in-out property <float> offset: 0;
        animate offset { duration: App.motion ? 220ms : 0ms; easing: ease-out; }
        property <int> base: floor(offset);
        property <float> frac: offset - base;

        TouchArea {
            scroll-event(e) => {
                // Колёсико: 100 px оригинала на щелчок × чувствительность 0,3.
                // Щелчок колёсика (60 px) — один слайд, как у Swiper оригинала.
                wheel.offset = wheel.offset - e.delta-y / 60px;
                accept
            }
        }

        if n > 0: Rectangle {
            for k in 13: WheelSlot {
                property <int> rel: k - 6;
                property <int> idx: mod(mod(wheel.base + rel, wheel.n) + wheel.n, wheel.n);
                entry: App.wheel[idx];
                p: rel - wheel.frac;
                slide-h: wheel.slide-h;
                wrap-x: wheel.wrap-x;
                area-h: wheel.height;
                area-w: wheel.width;
                clicked => {
                    if abs(self.p) >= 2.5 {
                        wheel.offset = wheel.offset + self.p;
                    } else {
                        App.play-wheel(self.idx);
                    }
                }
            }
        }
    }

    // Источник: «Моя волна» — просто подпись; волна по треку, исполнителю или вайбу — «челка» со сбросом.
    if App.has-track && !App.wave-context: Text {
        x: text-x;
        y: 38px;
        width: text-w;
        text: App.source-title;
        horizontal-alignment: center;
        font-family: WaveType.heading;
        font-size: Theme.font-size-headline-s;
        font-weight: 700;
        color: Theme.controls-color-primary-default-enabled;
    }
    if App.has-track && App.wave-context && !App.macos: ContextPill {
        x: text-x;
        y: 24px;
        width: text-w;
        text: App.source-title;
        reset => { App.reset-wave(); }
    }
    if App.has-track && App.wave-context && App.macos: MacContextPill {
        x: text-x;
        y: 22px;
        width: text-w;
        text: App.source-title;
        reset => { App.reset-wave(); }
    }

    // «Моя волна» без трека и на паузе — замер оригинала: 103 px в одну строку.
    idle-measure := Text {
        visible: false;
        text: T.t("Моя волна");
        font-family: WaveType.heading;
        font-size: 104px;
        font-weight: 700;
    }
    if !App.has-track || paused: Text {
        x: text-x;
        y: 171px + dt;
        width: text-w;
        text: T.t("Моя волна");
        horizontal-alignment: center;
        font-family: WaveType.heading;
        font-size: (App.macos ? clamp(floor(104 * text-w / max(1px, idle-measure.preferred-width)) * 1px - 1px,
            48px, App.plus ? 103px : 71px) : 103px / App.ui-scale);
        font-weight: 700;
        color: #ffffff;
    }

    if !App.has-track: Rectangle {
        x: cx - 32px;
        y: 580px + dp;
        width: 64px;
        height: 64px;
        border-radius: 32px;
        accessible-role: button;
        accessible-label: T.t("Воспроизведение");
        accessible-action-default => { App.play-pause(); }
        background: idle-ta.has-hover ? Theme.controls-color-primary-default-hovered : Theme.controls-color-primary-default-enabled;
        animate background { duration: App.motion ? 150ms : 0ms; }
        Icon { source: Icons.play-big; size: 32px; colorize: #000; }
        idle-ta := TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { App.play-pause(); } }
    }
    if !App.has-track: Icon { x: cx - 76px - 12px; y: 600px + dp; source: Icons.prev; size: 24px; colorize: #ffffff14; }
    if !App.has-track: Icon { x: cx - 76px + 140px; y: 600px + dp; source: Icons.next; size: 24px; colorize: #ffffff14; }

    // Исполнитель крупно: клик открывает его страницу.
    if !App.macos && App.has-track && !paused: FitTitle {
        x: text-x;
        y: title-y;
        width: text-w;
        height: 382px + dp - title-y;
        text: App.artists;
        longest: App.artists-longest;
        link: App.artist-list.length > 0;
        clicked => { App.open-current-artist(0); }
    }

    // Обложка открывает альбом трека, а не плеер на весь экран.
    if !App.macos && App.has-track: Cover {
        x: cx - 48px;
        y: 384px + dp;
        width: 96px;
        height: 96px;
        radius: Theme.radius-size-m;
        source: App.cover;
        TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { App.open-current-album(); } }
    }

    if App.has-track: HorizontalLayout {
        x: cx - (4 * (wave-action-size + 4px) + wave-track-width) / 2;
        y: 496px + dp;
        height: 64px;
        spacing: 4px;
        // Громкость: стеклянный ползунок над кнопкой, пока на ней курсор.
        Rectangle {
            y: 8px;
            width: root.wave-action-size;
            height: root.wave-action-size;
            property <bool> open: vol.hovered || vol-pop.hovered || bridge.has-hover;
            vol := GlassButton {
                width: root.wave-action-size;
                height: root.wave-action-size;
                label: T.t(App.volume <= 0 ? "Включить звук" : "Выключить звук");
                icon: App.volume <= 0 ? Icons.volume-off : Icons.volume;
                clicked => { App.toggle-mute(); }
            }
            bridge := TouchArea {
                y: -12px;
                height: 12px;
                visible: parent.open;
            }
            vol-pop := VolumePopup {
                x: (parent.width - self.width) / 2;
                y: -12px - self.height;
                visible: parent.open;
                glass: true;
            }
        }
        GlassButton {
            y: 8px;
            width: root.wave-action-size;
            height: root.wave-action-size;
            label: T.t("Не нравится");
            icon: Icons.dislike;
            enabled: App.is-wave;
            clicked => { App.dislike(); }
        }
        // Плашка трека — она же полоса перемотки: закрашена слева по прогрессу.
        pill := Rectangle {
            width: root.wave-track-width;
            height: 64px;
            border-radius: 32px;
            background: #ffffff14;
            accessible-role: slider;
            accessible-label: root.track-label + (App.macos && App.track-explicit ? " · 18+" : "") + " · " + T.t("Управление таймкодом");
            accessible-enabled: App.duration > 0;
            accessible-value: App.position;
            accessible-value-minimum: 0;
            accessible-value-maximum: App.duration;
            accessible-value-step: 5;
            accessible-action-set-value(v) => {
                if App.duration > 0 && v.is-float() { App.seek(max(0, min(App.duration, v.to-float()))); }
            }
            accessible-action-increment => { if App.duration > 0 { App.seek(min(App.duration, App.position + 5)); } }
            accessible-action-decrement => { if App.duration > 0 { App.seek(max(0, App.position - 5)); } }
            Rectangle {
                border-radius: 32px;
                clip: true;
                Rectangle {
                    x: 0;
                    width: parent.width * root.shown;
                    background: #ffffff14;
                }
            }
            track-measure := Text {
                visible: false;
                text: root.track-label;
                font-family: WaveType.heading;
                font-size: Theme.font-size-headline-xs;
                font-weight: 700;
            }
            Text {
                width: parent.width - (App.macos ? (App.track-explicit ? 46px : 24px) : 52px);
                height: 44px;
                text: root.track-label;
                horizontal-alignment: center;
                vertical-alignment: center;
                overflow: elide;
                font-family: WaveType.heading;
                font-size: !App.macos || track-measure.preferred-width <= self.width ? Theme.font-size-headline-xs
                    : track-measure.preferred-width * 0.8 <= self.width ? Theme.font-size-label-l : Theme.font-size-label-m;
                wrap: App.macos ? word-wrap : no-wrap;
                font-weight: 700;
                color: #ffffffb3;
            }
            if App.macos && App.track-explicit: Icon {
                x: parent.width - 30px;
                size: 14px;
                source: Icons.explicit;
                colorize: #ffffffb3;
            }
            pill-ta := TouchArea {
                mouse-cursor: MouseCursor.pointer;
                pointer-event(e) => {
                    if e.button == PointerEventButton.left && e.kind == PointerEventKind.down {
                        root.drag-progress = max(0, min(1, self.mouse-x / self.width));
                    }
                    if e.button == PointerEventButton.left && e.kind == PointerEventKind.up && root.drag-progress >= 0 {
                        App.seek(root.drag-progress * App.duration);
                        root.drag-progress = -1;
                    }
                }
                moved => {
                    if self.pressed {
                        root.drag-progress = max(0, min(1, self.mouse-x / self.width));
                    }
                }
            }
            // Подсказка времени: у бегунка при перемотке, у курсора при наведении.
            if pill-ta.has-hover || root.drag-progress >= 0: Rectangle {
                property <float> at: root.drag-progress >= 0 ? root.drag-progress : max(0, min(1, pill-ta.mouse-x / pill-ta.width));
                x: parent.width * at - self.width / 2;
                y: -32px;
                width: tip.preferred-width + 16px;
                height: 24px;
                border-radius: 12px;
                background: #000000b3;
                tip := Text {
                    text: App.format-time(at * App.duration) + " / " + App.format-time(App.duration);
                    font-size: Theme.font-size-label-xs;
                    font-weight: 500;
                    color: #ffffffe6;
                }
            }
        }
        GlassButton {
            y: 8px;
            width: root.wave-action-size;
            height: root.wave-action-size;
            label: T.t("Нравится");
            icon: App.liked ? Icons.liked : Icons.like;
            clicked => { App.like(); }
        }
        more := GlassButton {
            y: 8px;
            width: root.wave-action-size;
            height: root.wave-action-size;
            label: T.t("Контекстное меню");
            icon: Icons.more;
            clicked => { App.open-track-menu(self.absolute-position.x + self.width / 2, self.absolute-position.y); }
        }
    }

    if App.has-track: HorizontalLayout {
        x: cx - 88px;
        y: 580px + dp;
        width: 176px;
        height: 64px;
        spacing: 32px;
        Rectangle {
            width: 24px;
            accessible-role: button;
            accessible-label: T.t("Предыдущая песня");
            accessible-action-default => { App.prev(); }
            Icon { source: Icons.prev; size: 24px; colorize: prev-ta.has-hover ? #ffffffe6 : #ffffff80; }
            prev-ta := TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { App.prev(); } }
        }
        Rectangle {
            width: 64px;
            height: 64px;
            border-radius: 32px;
            accessible-role: button;
            accessible-label: T.t(App.playing ? "Пауза" : "Воспроизведение");
            accessible-action-default => { App.play-pause(); }
            background: App.macos && App.playing
                ? (play-ta.has-hover ? Theme.controls-color-secondary-default-hovered : Theme.controls-color-secondary-default-enabled)
                : (play-ta.has-hover ? Theme.controls-color-primary-default-hovered : Theme.controls-color-primary-default-enabled);
            animate background { duration: App.motion ? 150ms : 0ms; }
            Icon { source: App.playing ? Icons.pause-big : Icons.play-big; size: 32px; colorize: App.macos && App.playing ? #ffffff : #000; }
            play-ta := TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { App.play-pause(); } }
        }
        Rectangle {
            width: 24px;
            accessible-role: button;
            accessible-label: T.t("Следующая песня");
            accessible-action-default => { App.next(); }
            Icon { source: Icons.next; size: 24px; colorize: next-ta.has-hover ? #ffffffe6 : #ffffff80; }
            next-ta := TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { App.next(); } }
        }
    }

    if App.macos && App.has-track && (fact != "" || App.wave-message.action-title != ""): Rectangle {
        x: text-x + 24px;
        y: 684px + dp;
        width: text-w - 48px;
        height: 64px;
        property <bool> has-action: App.wave-message.action-title != "";
        Rectangle {
            x: 0;
            width: 72px;
            height: 56px;
            background: @radial-gradient(circle, #ffffff22 0%, transparent 82%);
        }
        Path {
            x: 12px;
            width: 18px;
            height: 18px;
            viewbox-width: 24;
            viewbox-height: 24;
            commands: "M12 0 Q14 10 24 12 Q14 14 12 24 Q10 14 0 12 Q10 10 12 0 Z";
            fill: #fff;
        }
        if App.wave-message.fact: Text {
            x: 30px;
            y: 18px;
            text: T.t("ИИ");
            font-family: WaveType.body;
            font-size: 10px;
            color: #fff;
        }
        if !App.wave-message.fact: Path {
            x: 29px;
            y: 17px;
            width: 10px;
            height: 10px;
            viewbox-width: 24;
            viewbox-height: 24;
            commands: "M12 0 Q14 10 24 12 Q14 14 12 24 Q10 14 0 12 Q10 10 12 0 Z";
            fill: #fff;
        }
        message := Rectangle {
            x: 56px;
            y: 0;
            width: parent.width - 64px;
            height: parent.has-action ? 41px : parent.height;
            Text {
                text: fact;
                wrap: word-wrap;
                overflow: elide;
                font-family: WaveType.body;
                font-size: Theme.font-size-label-l;
                font-weight: 500;
                color: #fff;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            if App.wave-message.fact && fact != "": Rectangle {
                accessible-role: button;
                accessible-label: fact;
                accessible-action-default => { App.open-wave-fact(); }
                TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { App.open-wave-fact(); } }
            }
        }
        if has-action: Rectangle {
            x: message.x;
            y: fact == "" ? 13px : 43px;
            width: message.width;
            height: 26px;
            accessible-role: button;
            accessible-label: App.wave-message.action-title;
            accessible-action-default => { App.open-wave-message(); }
            Text {
                text: App.wave-message.action-title;
                overflow: elide;
                font-family: WaveType.body;
                font-size: Theme.font-size-label-l;
                font-weight: 500;
                color: action-ta.has-hover ? #fff : #ffffff80;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            action-ta := TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { App.open-wave-message(); } }
        }
    }


    // Версия в правом нижнем углу, как у официального приложения.
    Rectangle {
        x: parent.width - self.width;
        y: parent.height - 38px;
        width: ver.preferred-width + 16px;
        height: 26px;
        border-radius: 16px;
        background: #ffffff14;
        ver := Text {
            text: App.version;
            font-size: Theme.font-size-label-s;
            font-weight: 500;
            color: #ffffff80;
        }
    }
    if App.macos && !App.logged-out: GlassButton {
        x: parent.width - self.width - 60px;
        y: 12px;
        width: 36px;
        height: 36px;
        icon: Icons.settings;
        icon-size: 20px;
        label: T.t("Настроить Мою волну");
        clicked => { App.open-wave-filters(); }
    }
    if App.wave-filters-open: WaveFilters { }
}

export component WaveFactDialog inherits Rectangle {
    accessible-role: groupbox;
    accessible-label: T.t("ИИ");
    Image {
        width: parent.width;
        height: parent.height;
        source: App.wave-fact-backdrop;
        image-fit: fill;
    }
    Rectangle { background: Theme.background-color-primary-enabled-overlay; }
    TouchArea { clicked => { App.close-wave-fact(); } }
    FocusScope {
        init => { self.focus(); }
        key-pressed(event) => {
            if event.text == Key.Escape || event.text == Key.Return {
                App.close-wave-fact();
                return accept;
            }
            return reject;
        }
    }
    viewport := Flickable {
        width: min(580px, root.width - 32px);
        x: (root.width - self.width) / 2;
        y: root.height * 0.16;
        height: root.height - self.y - 54px;
        content-width: self.width;
        content-height: max(self.height, article.preferred-height);
        article := VerticalLayout {
            width: viewport.width;
            y: max(0px, (viewport.height - self.preferred-height) / 2);
            height: self.preferred-height;
            spacing: Theme.spacer-size-xxl;
            Text {
                text: App.wave-message.text;
                font-family: WaveType.body;
                font-size: Theme.font-size-headline-xs;
                font-weight: 700;
                wrap: word-wrap;
                horizontal-alignment: center;
                color: #ffffffe6;
            }
            if App.wave-message.action-target != "": HorizontalLayout {
                alignment: center;
                PillButton {
                    text: App.wave-message.action-title;
                    clicked => { App.open-wave-message(); }
                }
            }
        }
    }
    Text {
        x: 16px;
        width: parent.width - 32px;
        y: parent.height - 44px;
        height: 16px;
        text: T.t("AI может ошибаться, проверяйте важное");
        font-family: WaveType.body;
        font-size: Theme.font-size-label-xs;
        font-weight: 500;
        horizontal-alignment: center;
        color: Theme.controls-color-primary-text-disabled;
    }
    GlassButton {
        x: parent.width - self.width - 24px;
        y: 24px;
        width: 48px;
        height: 48px;
        label: T.t("Закрыть");
        icon: Icons.close-xs;
        icon-size: 24px;
        clicked => { App.close-wave-fact(); }
    }
}
