// Нижний плеер.

import { Theme } from "theme.slint";
import { Icons, Icon, Cover, ArtistLinks, ExplicitMark } from "widgets.slint";
import { App, T } from "state.slint";
import { VolumePopup } from "popups.slint";

component BarButton inherits Rectangle {
    in property <image> icon;
    in property <length> icon-size: 24px;
    in property <bool> enabled: true;
    in property <bool> active;
    in property <string> label;
    in property <brush> ink: #ffffff80;
    in property <brush> ink-hover: #ffffffe6;
    in property <brush> ink-off: #ffffff14;
    out property <bool> hovered: ta.has-hover;
    callback clicked;
    width: 32px;
    height: 32px;
    border-radius: self.width / 2;
    accessible-role: button;
    accessible-label: label;
    accessible-enabled: enabled;
    accessible-action-default => { if enabled { root.clicked(); } }
    Icon {
        source: icon;
        size: icon-size;
        colorize: !enabled ? ink-off : active ? Theme.controls-color-primary-default-enabled : ta.has-hover ? ink-hover : ink;
        animate colorize { duration: App.motion ? Theme.duration-transition : 0ms; }
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.clicked(); }
    }
}

// Нижний плеер. Фон — цвет обложки (hsl с яркостью 20%), прогресс закрашивает фон слева направо.
export component PlayerBar inherits Rectangle {
    in property <bool> compact;
    property <float> progress: App.track-progress;
    animate progress { duration: App.animate-progress ? 250ms : 0ms; easing: linear; }
    property <float> drag-progress: -1;
    property <float> shown: drag-progress >= 0 ? drag-progress : App.animate-progress ? progress : App.track-progress;
    property <bool> on: App.has-track;
    property <length> side-gap: compact ? Theme.spacer-size-l : Theme.spacer-size-xxxl;
    property <length> transport-half: 160px + side-gap;
    property <length> right-controls: self.width - 193px;
    property <length> c: min(self.width / 2 - (App.macos ? Theme.spacer-size-m : 0px),
        right-controls - Theme.spacer-size-l - transport-half);
    property <length> transport-edge: c - transport-half;
    property <bool> vol-open: vol-btn.hovered || vol-pop.hovered;
    property <bool> dragging: drag-progress >= 0;
    // Полоса и бегунок видны при наведении на плеер или на зону перемотки.
    property <bool> show-progress: on && (bar-ta.has-hover || seek-ta.has-hover || dragging);
    property <float> hover-progress: max(0, min(1, seek-ta.mouse-x / root.width));

    inner := Rectangle {
        border-radius: Theme.radius-size-l;
        border-width: 1px;
        border-color: Theme.outline-color-primary-disabled;
        background: on ? App.tint : Theme.background-color-primary-enabled-player;
        clip: true;
        animate background { duration: App.motion ? Theme.duration-transition : 0ms; }

        if on: Rectangle {
            x: 0;
            width: parent.width * shown;
            height: parent.height;
            background: Theme.dark ? #ffffff0d : #0000000d;
        }
        // Полоса прогресса сверху: видна при наведении на плеер.
        if show-progress: Rectangle {
            y: 0;
            height: 4px;
            background: Theme.dark ? #ffffff1f : #0000001a;
            Rectangle {
                x: 0;
                width: parent.width * shown;
                background: Theme.controls-color-primary-default-enabled;
            }
        }

        bar-ta := TouchArea {
            mouse-cursor: on ? MouseCursor.pointer : MouseCursor.default;
            clicked => {
                if on {
                    App.open-fullscreen(0);
                }
            }

            if on: Cover {
                x: 9px;
                y: 8px;
                width: 64px;
                height: 64px;
                radius: Theme.radius-size-s;
                background: #ffffff14;
                source: App.cover;
                if cover-ta.has-hover: Rectangle {
                    background: #00000033;
                    Rectangle {
                        width: 44px;
                        height: 44px;
                        border-radius: 22px;
                        background: #1a1a1ae6;
                        Icon { source: Icons.fullscreen; size: 24px; colorize: #ffffff; }
                    }
                }
                cover-ta := TouchArea {
                    mouse-cursor: MouseCursor.pointer;
                    clicked => { App.open-fullscreen(0); }
                }
            }

            if on: Rectangle {
                x: 81px;
                y: 20px;
                width: transport-edge - self.x - Theme.spacer-size-l;
                height: 20px;
                HorizontalLayout {
                    alignment: start;
                    spacing: 4px;
                    title := Text {
                        text: App.title;
                        overflow: elide;
                        horizontal-stretch: 0;
                        vertical-alignment: center;
                        font-size: Theme.font-size-label-m;
                        font-weight: 500;
                        color: #ffffff;
            if title-ta.has-hover: Rectangle {
                x: 0;
                y: (parent.height + parent.font-size) / 2 + 1px;
                width: min(parent.width, parent.preferred-width);
                height: 1px;
                background: parent.color;
            }
                        title-ta := TouchArea {
                            mouse-cursor: MouseCursor.pointer;
                            clicked => { App.open-current-album(); }
                        }
                    }
                    if App.track-version != "": Text {
                        text: App.track-version;
                        overflow: elide;
                        horizontal-stretch: 0;
                        vertical-alignment: center;
                        font-size: Theme.font-size-label-m;
                        font-weight: 500;
                        color: #ffffff80;
                    }
                    if App.track-explicit: ExplicitMark { y: 1px; ink: #ffffff80; }
                    more := Rectangle {
                        width: 36px;
                        height: 20px;
                        Icon {
                            source: Icons.more-small;
                            size: 20px;
                            colorize: more-ta.has-hover || App.menu-open ? #ffffffe6 : #ffffff80;
                        }
                        more-ta := TouchArea {
                            mouse-cursor: MouseCursor.pointer;
                            clicked => { App.open-track-menu(more.absolute-position.x + 18px, more.absolute-position.y); }
                        }
                    }
                    Rectangle { horizontal-stretch: 1; }
                }
            }
            // Каждый исполнитель — отдельная ссылка.
            if on: ArtistLinks {
                x: 81px;
                y: 40px;
                width: min(self.content-width, transport-edge - self.x - Theme.spacer-size-l);
                height: 20px;
                names: App.artist-list;
                ink: #ffffff80;
                ink-hover: #ffffffe6;
                clicked(i) => { App.open-current-artist(i); }
            }

            BarButton {
                x: transport-edge;
                width: 44px;
                height: 44px;
                icon: Icons.dislike;
                label: T.t("Не нравится");
                enabled: on && App.is-wave;
                clicked => { App.dislike(); }
            }
            BarButton {
                x: c - 116px;
                icon: Icons.shuffle;
                label: T.t("Перемешать");
                enabled: on && !App.is-wave;
                active: App.shuffle;
                clicked => { App.toggle-shuffle(); }
            }
            BarButton {
                x: c - 68px;
                width: 44px;
                height: 44px;
                icon: Icons.prev-small;
                icon-size: 20px;
                label: T.t("Предыдущая песня");
                enabled: on && App.can-prev;
                clicked => { App.prev(); }
            }
            Rectangle {
                x: c - 20px;
                width: 40px;
                height: 40px;
                accessible-role: button;
                accessible-label: App.playing ? T.t("Пауза") : T.t("Воспроизведение");
                accessible-action-default => { App.play-pause(); }
                Icon {
                    source: App.playing ? Icons.pause-filled : Icons.play-filled;
                    size: play-ta.has-hover && App.motion ? 42px : 40px;
                    colorize: Theme.logo-color-primary-player;
                    animate size { duration: App.motion ? Theme.duration-transition : 0ms; }
                }
                play-ta := TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { App.play-pause(); } }
            }
            BarButton {
                x: c + 24px;
                width: 44px;
                height: 44px;
                icon: Icons.next-small;
                icon-size: 20px;
                label: T.t("Следующая песня");
                enabled: on;
                clicked => { App.next(); }
            }
            BarButton {
                x: c + 84px;
                icon: App.repeat == 2 ? Icons.repeat-one : Icons.repeat;
                label: T.t("Повтор");
                enabled: on && !App.is-wave;
                active: App.repeat > 0;
                clicked => { App.cycle-repeat(); }
            }
            BarButton {
                x: c + 116px + side-gap;
                width: 44px;
                height: 44px;
                icon: App.liked ? Icons.liked : Icons.like;
                label: T.t("Нравится");
                enabled: on;
                clicked => { App.like(); }
            }

            BarButton { x: right-controls; icon: Icons.lyrics; label: T.t("Текст песни"); enabled: on && App.has-lyrics; clicked => { App.open-fullscreen(2); } }
            BarButton { x: parent.width - 145px; icon: Icons.queue; label: T.t("Очередь воспроизведения"); enabled: on; clicked => { App.open-fullscreen(1); } }
            BarButton { x: parent.width - 97px; icon: Icons.settings; label: T.t("Настройки звука"); active: App.eq-open; clicked => { App.eq-open = !App.eq-open; } }
            vol-btn := BarButton {
                x: parent.width - 49px;
                icon: App.volume <= 0 ? Icons.volume-off : Icons.volume;
                label: App.volume <= 0 ? T.t("Включить звук") : T.t("Выключить звук");
                active: false;
                ink: vol-open ? #ffffffe6 : #ffffff80;
                clicked => { App.toggle-mute(); }
            }
        }
    }

    seek-ta := TouchArea {
        x: 0;
        y: -4px;
        width: root.width;
        height: 16px;
        enabled: on;
        mouse-cursor: MouseCursor.pointer;
        pointer-event(e) => {
            if e.button == PointerEventButton.left && e.kind == PointerEventKind.down {
                root.drag-progress = max(0, min(1, self.mouse-x / root.width));
            }
            if e.button == PointerEventButton.left && e.kind == PointerEventKind.up && root.drag-progress >= 0 {
                App.seek(root.drag-progress * App.duration);
                root.drag-progress = -1;
            }
        }
        moved => {
            if self.pressed {
                root.drag-progress = max(0, min(1, self.mouse-x / root.width));
            }
        }
    }

    if show-progress: Rectangle {
        x: root.width * shown - self.width / 2;
        y: -4px;
        width: 12px;
        height: self.width;
        border-radius: self.width / 2;
        background: Theme.controls-color-primary-default-enabled;
    }
    if on && (seek-ta.has-hover || dragging): Rectangle {
        property <float> at: dragging ? shown : hover-progress;
        x: max(0px, min(root.width - self.width, root.width * at - self.width / 2));
        y: -32px;
        width: time.preferred-width + 16px;
        height: 24px;
        border-radius: 12px;
        background: #000000b3;
        time := Text {
            text: App.format-time(at * App.duration) + " / " + App.format-time(App.duration);
            font-size: Theme.font-size-label-xs;
            font-weight: 500;
            color: #ffffffe6;
        }
    }

    vol-pop := VolumePopup {
        x: root.width - 49px + 16px - self.width / 2;
        y: 24px - self.height;
        visible: vol-open;
    }
}

export component MiniPlayer inherits Rectangle {
    property <bool> on: App.has-track;
    property <bool> can-seek: on && App.duration > 0;
    property <color> ink: on || Theme.dark ? #ffffff : #1a1a1a;
    property <float> progress: App.track-progress;
    animate progress { duration: App.animate-progress ? 250ms : 0ms; easing: linear; }
    property <float> drag-progress: -1;
    property <float> shown: drag-progress >= 0 ? drag-progress : App.animate-progress ? progress : App.track-progress;
    background: on ? App.tint : Theme.background-color-primary-enabled-player;
    animate background { duration: App.motion ? Theme.duration-transition : 0ms; }

    TouchArea {
        x: App.macos ? 76px : 0px;
        y: 0;
        width: volume-button.x - self.x;
        height: 32px;
        pointer-event(e) => {
            if e.kind == PointerEventKind.down && e.button == PointerEventButton.left { App.drag-window(); }
        }
        double-clicked => { App.toggle-mini(); }
    }

    BarButton {
        x: root.width - 36px;
        y: 2px;
        width: 32px;
        height: 28px;
        icon: Icons.fullscreen;
        icon-size: 16px;
        ink: root.ink.with-alpha(0.7);
        ink-hover: root.ink;
        label: T.t("Развернуть");
        clicked => { App.toggle-mini(); }
    }
    if !App.macos: BarButton {
        x: 4px;
        y: 2px;
        width: 28px;
        height: 28px;
        icon: Icons.close-xs;
        icon-size: 16px;
        ink: root.ink.with-alpha(0.7);
        ink-hover: root.ink;
        label: T.t("Закрыть");
        clicked => { App.close(); }
    }
    volume-button := BarButton {
        x: root.width - 136px;
        y: 2px;
        width: 28px;
        height: 28px;
        icon: App.volume <= 0 ? Icons.volume-off : Icons.volume;
        icon-size: 16px;
        ink: root.ink.with-alpha(0.7);
        ink-hover: root.ink;
        label: App.volume <= 0 ? T.t("Включить звук") : T.t("Выключить звук");
        clicked => { App.toggle-mute(); }
    }
    Rectangle {
        x: root.width - 104px;
        y: 4px;
        width: 56px;
        height: 24px;
        accessible-role: slider;
        accessible-label: T.t("Громкость");
        accessible-value: App.volume * 100;
        accessible-value-minimum: 0;
        accessible-value-maximum: 100;
        accessible-value-step: 5;
        accessible-action-set-value(v) => { if v.is-float() { App.set-volume(clamp(v.to-float() / 100, 0, 1)); } }
        accessible-action-increment => { App.set-volume(min(1, App.volume + 0.05)); }
        accessible-action-decrement => { App.set-volume(max(0, App.volume - 0.05)); }
        Rectangle {
            width: parent.width;
            height: 4px;
            border-radius: 2px;
            background: root.ink.with-alpha(0.18);
            Rectangle {
                x: 0;
                width: parent.width * App.volume;
                border-radius: 2px;
                background: root.ink.with-alpha(0.8);
            }
        }
        TouchArea {
            mouse-cursor: MouseCursor.pointer;
            pointer-event(e) => {
                if e.kind == PointerEventKind.down && e.button == PointerEventButton.left {
                    App.set-volume(clamp(self.mouse-x / self.width, 0, 1));
                }
            }
            moved => { if self.pressed { App.set-volume(clamp(self.mouse-x / self.width, 0, 1)); } }
            scroll-event(e) => {
                App.set-volume(clamp(App.volume + (e.delta-y > 0 ? 0.05 : -0.05), 0, 1));
                accept
            }
        }
    }

    if on: Cover {
        x: 12px;
        y: 32px;
        width: 48px;
        height: 48px;
        radius: Theme.radius-size-s;
        background: #ffffff14;
        source: App.cover;
    }
    VerticalLayout {
        x: on ? 72px : 12px;
        y: 32px;
        width: transport.x - self.x - 8px;
        height: 48px;
        alignment: center;
        spacing: 2px;
        Text {
            text: on ? App.title : App.app-name;
            overflow: elide;
            font-size: Theme.font-size-label-l;
            font-weight: 700;
            color: root.ink;
        }
        if on: Text {
            text: App.artists;
            overflow: elide;
            font-size: Theme.font-size-label-s;
            color: root.ink.with-alpha(0.65);
        }
    }

    transport := HorizontalLayout {
        x: root.width - 12px - self.width;
        y: 36px;
        width: 112px;
        height: 40px;
        alignment: center;
        spacing: 4px;
        BarButton {
            height: 40px;
            icon: Icons.prev-small;
            icon-size: 20px;
            ink: root.ink.with-alpha(0.7);
            ink-hover: root.ink;
            label: T.t("Предыдущая песня");
            enabled: on && App.can-prev;
            clicked => { App.prev(); }
        }
        BarButton {
            width: 40px;
            height: 40px;
            icon: App.playing ? Icons.pause-filled : Icons.play-filled;
            icon-size: 40px;
            ink: Theme.controls-color-primary-default-enabled;
            ink-hover: Theme.controls-color-primary-default-hovered;
            label: App.playing ? T.t("Пауза") : T.t("Воспроизведение");
            clicked => { App.play-pause(); }
        }
        BarButton {
            height: 40px;
            icon: Icons.next-small;
            icon-size: 20px;
            ink: root.ink.with-alpha(0.7);
            ink-hover: root.ink;
            label: T.t("Следующая песня");
            enabled: on;
            clicked => { App.next(); }
        }
    }

    if can-seek: HorizontalLayout {
        x: 12px;
        y: parent.height - 36px;
        width: parent.width - 24px;
        height: 28px;
        spacing: 8px;
        Text {
            min-width: 34px;
            text: App.format-time(root.shown * App.duration);
            font-size: Theme.font-size-label-s;
            vertical-alignment: center;
            color: root.ink.with-alpha(0.7);
        }
        Rectangle {
            horizontal-stretch: 1;
            accessible-role: slider;
            accessible-label: T.t("Управление таймкодом");
            accessible-value: App.position;
            accessible-value-minimum: 0;
            accessible-value-maximum: App.duration;
            accessible-value-step: 5;
            accessible-action-set-value(v) => { if v.is-float() { App.seek(clamp(v.to-float(), 0, App.duration)); } }
            accessible-action-increment => { App.seek(min(App.duration, App.position + 5)); }
            accessible-action-decrement => { App.seek(max(0, App.position - 5)); }
            Rectangle {
                width: parent.width;
                height: 4px;
                border-radius: 2px;
                background: root.ink.with-alpha(0.18);
                Rectangle {
                    x: 0;
                    width: parent.width * root.shown;
                    border-radius: 2px;
                    background: Theme.controls-color-primary-default-enabled;
                }
            }
            if seek.has-hover || seek.pressed: Rectangle {
                x: clamp(parent.width * root.shown - self.width / 2, 0px, parent.width - self.width);
                width: 8px;
                height: 8px;
                border-radius: 4px;
                background: Theme.controls-color-primary-default-enabled;
            }
            seek := TouchArea {
                mouse-cursor: MouseCursor.pointer;
                pointer-event(e) => {
                    if e.button == PointerEventButton.left && e.kind == PointerEventKind.down {
                        root.drag-progress = clamp(self.mouse-x / self.width, 0, 1);
                    }
                    if e.button == PointerEventButton.left && e.kind == PointerEventKind.up && root.drag-progress >= 0 {
                        App.seek(root.drag-progress * App.duration);
                        root.drag-progress = -1;
                    }
                }
                moved => { if self.pressed { root.drag-progress = clamp(self.mouse-x / self.width, 0, 1); } }
            }
        }
        Text {
            min-width: 34px;
            text: App.format-time(App.duration);
            font-size: Theme.font-size-label-s;
            horizontal-alignment: right;
            vertical-alignment: center;
            color: root.ink.with-alpha(0.7);
        }
    }
}
